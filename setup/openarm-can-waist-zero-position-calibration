import openarm_can as oa
import argparse
import time
import numpy as np
from enum import IntEnum

# ---------- IDs / Limits / Signs ----------


class WaistJointID(IntEnum):
    YAW = 0
    PITCH = 1


mech_lim = {
    WaistJointID.PITCH: [np.deg2rad(-10), np.deg2rad(90)],
    WaistJointID.YAW: [np.deg2rad(0), np.deg2rad(180)],
}

# Per-joint sign convention used in ideal-zero delta computation
JOINT_SIGN = {
    WaistJointID.YAW: +1.0,
    WaistJointID.PITCH: +1.0,
}

# ---------- Core motion primitives ----------


def interpolate(openarm, comp, joint_id: WaistJointID, delta_rad,
                kp=52.0, kd=1.5, torque_assist=0.0, interp_time=2.0):
    """Linear interp: current -> current+delta with MIT control."""
    idx = int(joint_id)
    m = comp.get_motors()[idx]
    q0 = m.get_position()
    q1 = q0 + float(delta_rad)
    n_steps, dt = 500, (interp_time / 500.0)
    tau = np.copysign(1.0, q1 - q0) * abs(torque_assist)
    for i in range(n_steps + 1):
        alpha = i / n_steps
        q = q0 + (q1 - q0) * alpha
        comp.mit_control_one(idx, oa.MITParam(kp, kd, q, 0.0, tau))
        openarm.recv_all()
        time.sleep(dt)


def _hit_thresholds(comp, idx):
    """Return (dq_th, tau_th) for waist joints."""
    return 0.0125, 5.0


def bump_to_limit(openarm, comp, joint_id,
                  step_deg=0.2, kp=45.0, kd=1.2, torque_bias=0.0):
    """Step until mechanical stop. Return traveled delta [rad]."""
    idx = int(joint_id)
    step_rad = np.deg2rad(step_deg)
    tau_cmd = np.copysign(1.0, step_deg) * abs(torque_bias)

    motors = comp.get_motors()
    q_start = motors[idx].get_position()
    q_target = q_start

    dq_th, tau_th = _hit_thresholds(comp, idx)

    while True:
        q_target += step_rad
        comp.mit_control_one(idx, oa.MITParam(kp, kd, q_target, 0.0, tau_cmd))
        openarm.recv_all()
        time.sleep(0.005)

        m = comp.get_motors()[idx]
        if np.abs(m.get_velocity()) < dq_th and np.abs(m.get_torque()) > tau_th:
            delta_rad = m.get_position() - q_start
            delta_deg = np.rad2deg(delta_rad)
            print(f"[INFO] mechanical stop (Joint {joint_id.name}): "
                  f"{delta_rad:.4f} rad / {delta_deg:.2f}°")
            return float(delta_rad)


def move_to_abs(openarm, comp, target_q_list, interp_time=2.0):
    """Move all joints to absolute positions."""
    motors = comp.get_motors()
    start_q = [m.get_position() for m in motors]

    n_steps = 500
    dt = interp_time / n_steps

    for i in range(n_steps + 1):
        alpha = i / n_steps
        for idx, m in enumerate(motors):
            q = start_q[idx] + (target_q_list[idx] - start_q[idx]) * alpha
            comp.mit_control_one(idx, oa.MITParam(200.0, 3.0, q, 0.0, 0.0))
        openarm.recv_all()
        time.sleep(dt)

    # Hold final for a bit
    for _ in range(50):
        for idx, m in enumerate(motors):
            comp.mit_control_one(idx, oa.MITParam(200.0, 3.0, target_q_list[idx], 0.0, 0.0))
        openarm.recv_all()
        time.sleep(0.01)

# ---------- Waist calibration sequence ----------


def _run_waist_sequence(openarm, waist):
    """
    Calibration sequence for waist:
    1. Pitch hits negative limit (corresponds to -10 degrees)
    2. Yaw hits negative limit (corresponds to 0 degrees)
    """
    print("[INFO] Starting waist calibration sequence")

    # Step 1: Pitch to negative limit (-10 degrees)
    print("[INFO] Moving pitch to negative limit (-10°)...")
    d_pitch = bump_to_limit(openarm, waist, WaistJointID.PITCH,
                           step_deg=-0.2, kp=180, kd=2.1)
    time.sleep(0.5)

    # Step 2: Yaw to negative limit (0 degrees)
    print("[INFO] Assuming current yaw as 0...")
    # d_yaw = bump_to_limit(openarm, waist, WaistJointID.YAW, step_deg=-0.1, kp=3, kd=0.1)
    d_yaw = 0.
    time.sleep(0.5)

    ideal = {
        WaistJointID.PITCH: np.deg2rad(-10),
        WaistJointID.YAW: np.deg2rad(0),
    }
    deltas = [d_yaw, d_pitch]
    return ideal, deltas

# ---------- Main ----------


def main():
    parser = argparse.ArgumentParser(
        description='Waist zero-position calibration')
    parser.add_argument('--canport', type=str, default='can0')
    args = parser.parse_args()
    print(f"parser arg : {args}")

    # Init waist motors
    openarm = oa.OpenArm(args.canport, True)
    openarm.init_arm_motors(
        [oa.MotorType.DM8009, oa.MotorType.DM10010L],
        [0x09, 0x0A],
        [0x19, 0x1A]
    )
    # openarm.init_arm_motors(
    #     [oa.MotorType.DM8009],
    #     [0x09],
    #     [0x19]
    # )

    print("Enabling waist motors...")
    openarm.enable_all()
    time.sleep(0.1)
    openarm.recv_all()
    print("Enabled...")

    # Hold current pose (light PD)
    openarm.set_callback_mode_all(oa.CallbackMode.STATE)

    openarm.recv_all()
    waist = openarm.get_arm()
    wm = waist.get_motors()

    initial_waist_q = [m.get_position() for m in wm]

    waist_params = [oa.MITParam(kp, kd, q, 0.0, 0.0)
                    for kp, kd, q in zip([300, 300],
                                         [2.5, 2.5],
                                         initial_waist_q)]
    waist.mit_control_all(waist_params)
    openarm.recv_all()


    try:
        # Run waist calibration sequence
        ideal, deltas = _run_waist_sequence(openarm, waist)

        # Calculate target absolute positions (physical zero)
        # We are currently at the mechanical limit.
        # If limit is -10 deg, zero is +10 deg away.
        # Target = Current - LimitVal

        current_q = [m.get_position() for m in waist.get_motors()]
        target_q = []

        # Mapping: 0->Yaw, 1->Pitch based on init order [0x09, 0x0A]
        for idx in range(2):
            joint_id = WaistJointID(idx)
            limit_val = ideal[joint_id]
            current_val = current_q[idx]

            target_val = current_val - limit_val
            target_q.append(target_val)

            print(f"[INFO] Joint {joint_id.name}: "
                  f"HitLimit={np.rad2deg(current_val):.2f}°, "
                  f"IdealLimit={np.rad2deg(limit_val):.2f}°, "
                  f"TargetZero={np.rad2deg(target_val):.2f}°")

        # Move to calculated zero position
        print("[INFO] Moving to physical zero position...")
        move_to_abs(openarm, waist, target_q, interp_time=3.0)
        print("[INFO] Reached zero position.")

        # Safe disable before writing zeros
        openarm.disable_all()
        openarm.recv_all()
        openarm.set_zero_all()
        openarm.recv_all()
        print("[INFO] Wrote zero position to waist motors")

    except KeyboardInterrupt:
        print("\n[INFO] Ctrl+C pressed → stopping safely")
    finally:
        openarm.disable_all()
        print("[INFO] Motors disabled, exiting safely.")


if __name__ == "__main__":
    main()
